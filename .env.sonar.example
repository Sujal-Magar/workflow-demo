# SonarQube configuration — kept separate from the app's own .env so Sonar
# credentials never sit alongside AWS/SES/database config.
#
# Copy this file to .env.sonar.local (gitignored) and fill in your token.
# Read by scripts/sonar-fetch.ts to reach the local SonarQube server.

# Local SonarQube server URL. Defaults to http://localhost:9000 if left blank.
SONAR_HOST_URL=http://localhost:9000

# User or project analysis token — generate one in SonarQube under
# My Account -> Security -> Generate Token. Leave blank only if the local
# server allows anonymous analysis; otherwise fetches fail with 401.
SONAR_TOKEN=
